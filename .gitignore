# Generated by Cargo
# will have compiled files and executables
**/target/*
# But keep program keypairs for CI (needed for fixture consistency)
!solana-pa-prototype/target/deploy/
solana-pa-prototype/target/deploy/*
!solana-pa-prototype/target/deploy/*-keypair.json

# These are backup files generated by rustfmt
**/*.rs.bk

# Mainnet keypairs — NEVER commit these
solana-pa-prototype/scripts/mainnet-wallet.json
solana-pa-prototype/scripts/mainnet-fee-payer.json

# Claude Code
.claude/

# OS files
.DS_Store

# IDE
.idea/
.vscode/
