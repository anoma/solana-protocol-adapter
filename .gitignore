# Generated by Cargo
# will have compiled files and executables
**/target/*
# But keep program keypairs for CI (needed for fixture consistency)
!solana-pa-prototype/target/deploy/
solana-pa-prototype/target/deploy/*
!solana-pa-prototype/target/deploy/*-keypair.json

# These are backup files generated by rustfmt
**/*.rs.bk

# Claude Code
.claude/

# Mainnet keypairs (secrets)
solana-pa-prototype/scripts/mainnet-*.json

# OS files
.DS_Store

# IDE
.idea/
.vscode/
