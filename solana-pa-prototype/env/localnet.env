# The local validator's program addresses. The integration suite loads each
# program at genesis under these, and the committed fixtures prove against
# them, so they are committed test configuration. A local validator needs no
# program keypair.
PROTOCOL_ADAPTER_PROGRAM_ID=2gH5DnTwDLLFk3oYxnbrceSFdTMtvaxQz29x5W8Etmpx
BLOCK_TIME_FORWARDER_PROGRAM_ID=3mesRGxMv9wRB1xp7X4uxbf7GwnQC9PpHSJyCzcXwrsf
TEST_FORWARDER_PROGRAM_ID=QfyNAtiNrw1YJAm9FzShw6oVZ4BDHojKrpje2mNNctD
MOCK_VERIFIER_PROGRAM_ID=H3ZFoDHFvthGZu3kxpif3oSWm8MQn8uKvgDhrvVVHvHf
# The RISC Zero verifier router and the selector of the verifier the adapter
# verifies with, compiled into the adapter as pa-evm's implementation takes
# them at construction (RISC_ZERO_VERIFIER_ROUTER, RISC_ZERO_VERIFIER_SELECTOR).
# The local validator loads devnet's router (devnet-programs/); a mock-proof
# run builds with the mock verifier's selector instead (MOCK_SELECTOR in
# scripts/validator-deploy.sh).
RISC_ZERO_VERIFIER_ROUTER=BetEAE4npinksQBxvqUN1KkCVjYFJywWao45MSWtp5yg
RISC_ZERO_VERIFIER_SELECTOR=0xe71e6620
